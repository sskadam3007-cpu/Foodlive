SECRET_KEY=generate_a_secure_django_secret_key_here
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,foodlive.app

# PostgreSQL / PostGIS
DB_NAME=foodlive_db
DB_USER=foodlive_user
DB_PASSWORD=your_secure_db_password
DB_HOST=db
DB_PORT=5432

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_STORAGE_BUCKET_NAME=foodlive-media
AWS_S3_REGION_NAME=ap-south-1